# portal-client reads the SHARED repo-root .env (vite envDir = ".."), so these
# normally live in client-portal-prepship/.env — listed here for reference.
#
# Supabase (client-side auth — the portal logs in via supabase-js and sends the
# JWT as a Bearer token to the backend):
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend API base URL. In dev this is IGNORED — requests go to /api and Vite
# proxies them to the backend (default http://localhost:3000), avoiding CORS.
# Set this for PRODUCTION builds to the absolute API origin.
VITE_API_URL=http://localhost:3000

# Optional: override the dev proxy target if the API runs elsewhere.
# VITE_API_PROXY_TARGET=http://localhost:3000
