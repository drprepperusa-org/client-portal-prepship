{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:web",
  "outputDirectory": "portal-client/dist",
  "installCommand": "npm install && npm --prefix portal-client install",
  "rewrites": [
    {
      "source": "/api/client-portal/:path*",
      "destination": "https://client-portal-prepship.onrender.com/api/client-portal/:path*"
    },
    { "source": "/maintenance", "destination": "/maintenance.html" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ]
}
